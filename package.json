      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged --relative",
    "lint": "prettier . --check",
    "format": "prettier . --write"
