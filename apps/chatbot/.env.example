# Chatbot
BOT_USER_ID=858050963
BOT_CHANNEL_NAMES=alveusgg

## Loggging (CRITICAL, ERROR, WARNING, INFO, DEBUG, TRACE), defaults to ERROR
BOT_LOGLEVEL=ERROR

# Users
MODERATOR_USER_NAMES=alveusgg

# Website API
API_BASE_URL=http://localhost:3000/api/
API_SECRET=
# Optional: absolute path to the dedicated website chatbot preset key file.
# Docker mounts this file read-only at the same path; unset disables preset commands.
# PRESETS_SITE_KEY_FILE=/run/secrets/chatbot-presets-key

# Prisma
DATABASE_URL='mysql://root:alveusgg_secret@localhost:3306/alveusgg?allowPublicKeyRetrieval=true'

# Twitch OAuth
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Sentry error tracking (optional) - Sentry is disabled when SENTRY_DSN is not set
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT= (set by the deploy workflow, defaults to development)
