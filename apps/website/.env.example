# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# When adding additional env variables, the schema in ./src/env/index.js should be updated accordingly

# Next.js
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_SHORT_BASE_URL=https://alveus.gg
NEXT_PUBLIC_NOINDEX=true

# Stream overlay: auto (dates), default (usual seasonal borders), or a configured theme name (e.g. wolf-week)
# URL theme= overrides this value. Restart dev or rebuild/redeploy after changing it.
# NEXT_PUBLIC_STREAM_OVERLAY_THEME=auto

# Next.js: Tophat global promotion
# NEXT_PUBLIC_GLOBAL_PROMOTION_TITLE=T-shirts, hoodies, and more!
# NEXT_PUBLIC_GLOBAL_PROMOTION_CTA=Merch Available Now
# NEXT_PUBLIC_GLOBAL_PROMOTION_LINK=/apparel
# NEXT_PUBLIC_GLOBAL_PROMOTION_EXTERNAL=true
# NEXT_PUBLIC_GLOBAL_PROMOTION_EXCLUDED=

# Next.js: Donation page event banner
# NEXT_PUBLIC_DONATION_EVENT_TITLE=Alveus Charity Event
# NEXT_PUBLIC_DONATION_EVENT_DESCRIPTION=Looking to donate as part of the Alveus Charity Event, to get the limited edition postcard?
# NEXT_PUBLIC_DONATION_EVENT_CTA=Donate via Twitch Charity
# NEXT_PUBLIC_DONATION_EVENT_LINK=https://www.twitch.tv/charity/alveussanctuary
# NEXT_PUBLIC_DONATION_EVENT_EXTERNAL=true

# Prisma
DATABASE_URL='mysql://root:alveusgg_secret@localhost:3306/alveusgg?allowPublicKeyRetrieval=true'

# Next Auth
#   You can generate the secret via 'openssl rand -base64 32' on Linux
# More info: https://next-auth.js.org/configuration/options#secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Twitch OAuth
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# OAuth signing key
#   Generate an RSA private key with:
#   openssl genrsa -out oauth-private.pem 2048
#   Then copy the PEM contents into one env var with literal \n escapes, for example:
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' oauth-private.pem
#   Do not wrap the final value in quotes.
#   Keep OAUTH_KID stable for a given keypair, and change it when rotating keys.
OAUTH_PRIVATE_KEY_PEM=
OAUTH_KID=oauth-1

# OAuth confidential clients JSON
#   "name" is shown to users on the sign-in/authorize screens.
#   "clientCredentialsScopes" (optional) lists the user roles a client may request
#   via the client_credentials grant. Omit it to disable that grant for the client.
#   Example:
#   OAUTH_CLIENTS_JSON=[{"clientId":"census-production","clientSecret":"replace-me","name":"Census","redirectUris":["http://localhost:3001/callback"],"clientCredentialsScopes":["census_moderator"]}]
OAUTH_CLIENTS_JSON=

# Exclude Twitch clips from overlay (optional, space-separated)
TWITCH_EXCLUDED_CLIPS=

# Discord token + guild IDs for calendar events (optional, space-separated)
DISCORD_BOT_TOKEN=
DISCORD_CALENDAR_EVENT_GUILD_IDS=12345678901234567890 12345678901234567890

# Discord Channel Webhooks for notifications (optional, space-separated)
DISCORD_CHANNEL_WEBHOOK_NAME="Alveus Test"
DISCORD_CHANNEL_WEBHOOK_URLS_STREAM_NOTIFICATION=https://discord.com/api/webhooks/aaa/xyz https://discord.com/api/webhooks/bbb/xyz
DISCORD_CHANNEL_WEBHOOK_URLS_ANNOUNCEMENT=https://discord.com/api/webhooks/ccc/xyz

# Send Discord Channel notifications to @everyone (optional, defaults to false)
#DISCORD_CHANNEL_WEBHOOK_TO_EVERYONE_STREAM_NOTIFICATION=true
#DISCORD_CHANNEL_WEBHOOK_TO_EVERYONE_ANNOUNCEMENT=true

# Action API secret
#   You can generate the secret via 'openssl rand -base64 32' on Linux
ACTION_API_SECRET=

# Vercel Cron secret (see https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs)
#   Required in production, /api/cron refuses to run without it
#   You can generate the secret via 'openssl rand -base64 32' on Linux
CRON_SECRET=

# Weather API secret
#   You can add a weather station to wunderground.com for this
# More info: https://www.wunderground.com/member/api-keys
#            https://www.wunderground.com/pws/overview
WEATHER_API_KEY=
WEATHER_STATION_ID=INUNAV15

# YouTube API key
#   Only required for the /live/youtube/chat endpoint, can be left empty
# More info: https://console.cloud.google.com/apis/credentials
#            https://developers.google.com/youtube/v3/getting-started
YOUTUBE_API_KEY=

# Web Push VAPID Key
#   You can generate the keys via 'npx web-push generate-vapid-keys'
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@alveus.gg

# Web Push delivery (optional)
#   Language and text direction of the notifications (defaults to en and ltr)
# PUSH_LANG=en
# PUSH_TEXT_DIR=ltr
#   Subscriptions handled per batch, and the delay in ms between batches (defaults to 50 and 1000)
# PUSH_BATCH_SIZE=50
# PUSH_BATCH_DELAY_MS=1000
#   Attempts per push, and the base delay in ms for the exponential retry backoff (defaults to 5 and 10000)
# PUSH_MAX_ATTEMPTS=5
# PUSH_RETRY_DELAY_MS=10000

# File Storage (S3-compatible)
FILE_STORAGE_ENDPOINT=http://localhost:9000
FILE_STORAGE_SECRET=alveusgg_secret
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_KEY=alveusgg_key
FILE_STORAGE_CDN_URL=
FILE_STORAGE_BUCKET=alveusgg
FILE_STORAGE_PATH_STYLE=true # Include the bucket in the path, not as a subdomain

# Upstash QStash (optional) - Used to queue web push messages
# UPSTASH_QSTASH_URL=https://qstash.upstash.io/v1/publish/
# UPSTASH_QSTASH_KEY=

# Upstash Redis (optional) - Used for rate limiting and OAuth code storage
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Redis URL (optional, local development only) - e.g. redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Disable admin authentication for local development
DISABLE_ADMIN_AUTH=false

# Super users
SUPER_USER_IDS=

# Encryption passphrase for data at rest
#   You can generate the secret via 'openssl rand -base64 24' on Linux
DATA_ENCRYPTION_PASSPHRASE=

# Encryption keys for personal data and secrets at rest
#   Comma-separated list of <key id>:<base64 32-byte key>. The first key encrypts, all keys decrypt.
#   You can generate a key via 'echo "k1:$(openssl rand -base64 32)"' on Linux
DATA_ENCRYPTION_KEYS=

# Key for blind indexes (keyed hashes to look up encrypted values like email addresses)
#   You can generate the secret via 'openssl rand -base64 32' on Linux
#   Changing it means recomputing every stored blind index
DATA_BLIND_INDEX_KEY=

# Cloudflare stream, LOLA stream (optional)
CF_STREAM_HOST=
CF_STREAM_KEY_ID=
CF_STREAM_KEY_JWK=
CF_STREAM_LOLA_VIDEO_ID=

# TRPC API keys for secure connected systems (optional)
# Space-separated to allow rotating keys, the first one is sent to the donations worker
TRPC_API_SHARED_KEY=

# Neon CRM donor login for pixel renames (optional)
#   Client ID/secret: Neon CRM > Settings > Global Settings > OAuth Configuration.
NEON_CRM_ORG_ID=alveussanctuary
NEON_OAUTH_CLIENT_ID=
NEON_OAUTH_CLIENT_SECRET=

# Real-time pixels donation feed
#   Generate fake events in development when using the sync provider
NEXT_PUBLIC_DONATIONS_DEMO_MODE=true
#   URL of the donations worker (apps/donations/worker), required for live syncing when not in demo mode
# NEXT_PUBLIC_DONATIONS_MANAGER_URL=http://localhost:8787

# Pixels rename lock duration in ms (optional, defaults to 60000, i.e. 1 minute)
# NEXT_PUBLIC_PIXELS_RENAME_LOCK_DURATION_MS=60000

# Pixels audit log Discord webhook
PIXELS_AUDIT_LOG_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ddd/xyz

# Sentry server-side error tracking (optional) - Sentry is disabled when SENTRY_DSN is not set
#   Release defaults to VERCEL_GIT_COMMIT_SHA, environment defaults to VERCEL_TARGET_ENV, VERCEL_ENV then NODE_ENV
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=
