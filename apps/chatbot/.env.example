# Chatbot
BOT_USER_ID=858050963
BOT_CHANNEL_NAMES=alveusgg

## Loggging (CRITICAL, ERROR, WARNING, INFO, DEBUG, TRACE), defaults to ERROR
BOT_LOGLEVEL=ERROR

# Users
MODERATOR_USER_NAMES=alveusgg

# Website API
API_BASE_URL=http://localhost:3000/api/
API_SECRET=

# Prisma
DATABASE_URL='mysql://root:alveusgg_secret@localhost:3306/alveusgg?allowPublicKeyRetrieval=true'

# Encryption keys for the Twitch OAuth tokens in the database, must be the same as the website
#   Comma-separated list of <key id>:<base64 32-byte key>. The first key encrypts, all keys decrypt.
DATA_ENCRYPTION_KEYS=

# Leave false for the initial read-compatible chatbot deployment.
# Set true and redeploy only after the website can read encrypted tokens.
OAUTH_TOKEN_ENCRYPTION_ENABLED=false

# Twitch OAuth
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Sentry error tracking (optional) - Sentry is disabled when SENTRY_DSN is not set
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT= (set by the deploy workflow, defaults to development)
