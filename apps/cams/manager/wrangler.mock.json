{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cams-manager-local",
  "main": "dev/manager.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "exports": {
    "CamControllerDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALVEUS_AUTH_ISSUER": "http://127.0.0.1:8798",
    "CONTROL_API_TOKEN": "mock"
  },
  "services": [
    { "binding": "CONTROL_API", "service": "cams-control-api-local" },
    { "binding": "EVENTS", "service": "cams-control-events-local" }
  ]
}
